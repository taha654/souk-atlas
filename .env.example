# Copier ce fichier en .env puis changer les mots de passe.
# .env n'est jamais versionné (voir .gitignore).

# Mot de passe des comptes administrateurs Oracle (SYS, SYSTEM)
ORACLE_PASSWORD=change_moi_admin

# Utilisateur applicatif : propriétaire du schéma du site
APP_USER=SOUK
APP_USER_PASSWORD=change_moi_app

# Ports exposés sur la machine hôte.
# 1522 et 8000 plutôt que 1521 et 8080 : un Oracle installé sous Windows
# occupe souvent ces deux ports (listener et console XML DB).
ORACLE_PORT=1522
WEB_PORT=8000

# Application
APP_ENV=dev
# Adresse publique du site (liens dans les emails)
APP_URL=http://localhost:8000
# Déconnexion après 30 minutes d'inactivité
SESSION_INACTIVITE_SECONDES=1800
# Mettre 1 en production derrière HTTPS (voir app/Core/Session.php)
SESSION_COOKIE_SECURE=0

# uid / gid de votre utilisateur (commande : id -u ; id -g). Apache écrit les
# fichiers du site (emails simulés, photos) avec cette identité.
HOST_UID=1000
HOST_GID=1000

# Clé de l'API Pixabay (https://pixabay.com/api/docs/), seulement pour retélécharger
# les photos de démo avec tools/photos_demo.php. Le site n'en a pas besoin.
PIXABAY_API_KEY=
