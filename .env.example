# Copier ce fichier en .env puis changer les mots de passe.
# .env n'est jamais versionné (voir .gitignore).

# Mot de passe des comptes administrateurs Oracle (SYS, SYSTEM)
ORACLE_PASSWORD=change_moi_admin

# Utilisateur applicatif : propriétaire du schéma du site
APP_USER=SOUK
APP_USER_PASSWORD=change_moi_app

# Ports exposés sur la machine hôte.
# 1522 et 8000 plutôt que 1521 et 8080 : un Oracle installé sous Windows
# occupe souvent ces deux ports (listener et console XML DB).
ORACLE_PORT=1522
WEB_PORT=8000
